# ============================================================
# LUXE VTON - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Client URL (comma-separated for multiple origins in production)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JSON Web Token
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-generated-64-byte-hex-secret
JWT_EXPIRE=7d

# Cookie signing secret (optional, defaults to JWT_SECRET)
COOKIE_SECRET=your-cookie-secret

# Nodemailer (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Replicate AI (for production try-on model)
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Hugging Face (for Gradio-based try-on models)
# Get token from: https://huggingface.co/settings/tokens
TRYON_HF_TOKEN=

# ---- AI Try-On Provider Routing ----

# Primary model: IDM-VTON
TRYON_IDM_SPACE=yisol/IDM-VTON
TRYON_IDM_API_NAME=/tryon

# Optional fallback models (set spaces to enable)
TRYON_OUTFITANYONE_SPACE=
TRYON_OUTFITANYONE_API_NAME=/tryon

TRYON_CATVTON_SPACE=
TRYON_CATVTON_API_NAME=/tryon

# Generation settings (applies to all providers)
TRYON_DENOISE_STEPS=20
TRYON_SEED=42
TRYON_AUTO_MASK=true
TRYON_AUTO_CROP=false

# Replicate model version (if using Replicate instead of Gradio)
TRYON_REPLICATE_MODEL=
TRYON_REPLICATE_VERSION=